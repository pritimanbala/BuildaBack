# PostgreSQL (replace with the credentials you will provide)
DATABASE_URL=postgresql://neondb_owner:****@ep-tiny-base-b3gqs5x1-pooler.c-4.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Generate a long random value, e.g. `python -c "import secrets; print(secrets.token_urlsafe(48))"`
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Comma-separated browser origins allowed to call this API
FRONTEND_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173
COOKIE_SECURE=false

# Create these in Google Cloud Console. Leave empty to disable Google sign-in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback
